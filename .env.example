# Supabase (hosted Postgres + Storage; local dev via `supabase start`)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
CASEZERO_SOURCE_ROOT=data/sources

# Hyperfusion (OpenAI-compatible inference; open-weight models)
HYPERFUSION_API_KEY=
HYPERFUSION_BASE_URL=https://api.hyperfusion.io/v1
CASEZERO_TEXT_MODEL=qwen/qwen3-32b
CASEZERO_VISION_MODEL=google/gemma-4-31b-it

# Context.dev (docket discovery only — never callable during blind investigation)
CONTEXTDEV_API_KEY=

# ElevenLabs (audio transcription only, when a case has public audio)
ELEVENLABS_API_KEY=

# NTSB developer portal (case metadata; requires signup at developer.ntsb.gov)
NTSB_API_SUBSCRIPTION_KEY=
# Copy the GetCase request URL from the authenticated portal and replace the identifier with {identifier}.
NTSB_GET_CASE_URL_TEMPLATE=
